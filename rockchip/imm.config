# ============================================================================
# imm.config —— OpenWrt 25.12.x 官方 Image Builder 配置（NanoPi R2S 专用）
# ----------------------------------------------------------------------------
# 官方 Image Builder 的 `make image` 会先对本文件做 defconfig 归并：
# 未写出的符号全部取默认值，未知符号被静默忽略，因此这里只保留必要项即可。
#
# 说明：
#   - 机型在下方显式指定（与官方 profiles.json 中的 profile id 一致）；
#   - CONFIG_SIGNATURE_CHECK=y：开启 apk 源签名校验。第三方源（dllkids）
#     的公钥由 rockchip/build.sh 注入 keys/ 目录，缺失公钥的源会报
#     "UNTRUSTED signature"；
#   - CONFIG_TARGET_ROOTFS_PARTSIZE 只是默认值（MiB），构建时会被工作流传入的
#     make image ROOTFS_PARTSIZE=<1G-4G 折算 MiB> 覆盖；
#   - PROFILE 与 PACKAGES 由 build.sh 通过 make image 命令行传入。
# ============================================================================

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_MULTI_PROFILE=y

CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=y
CONFIG_TARGET_DEVICE_PACKAGES_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=""

CONFIG_SIGNATURE_CHECK=y

CONFIG_TARGET_ROOTFS_PARTSIZE=300
